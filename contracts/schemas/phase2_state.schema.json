{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-montage/phase2/phase2_state.schema.json",
  "title": "Phase 2 Global State",
  "type": "object",
  "required": [
    "request_id",
    "input_manifest",
    "scenes",
    "tasks",
    "task_graph",
    "audio_jobs",
    "video_jobs",
    "face_swap_jobs",
    "sync_jobs",
    "artifacts",
    "memory_refs",
    "status",
    "errors",
    "audit"
  ],
  "additionalProperties": false,
  "properties": {
    "request_id": { "type": "string", "minLength": 1 },
    "input_manifest": {
      "type": "object",
      "required": ["path", "scene_count"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "scene_count": { "type": "integer", "minimum": 1 }
      }
    },
    "scenes": { "type": "array" },
    "tasks": { "type": "array" },
    "task_graph": { "type": "object" },
    "audio_jobs": { "type": "array" },
    "video_jobs": { "type": "array" },
    "face_swap_jobs": { "type": "array" },
    "sync_jobs": { "type": "array" },
    "artifacts": {
      "type": "object",
      "required": ["audio_tracks", "frame_sequences", "video_scenes", "raw_scenes", "task_graph_logs"],
      "additionalProperties": false,
      "properties": {
        "audio_tracks": { "type": "array", "items": { "$ref": "#/$defs/artifact_ref" } },
        "frame_sequences": { "type": "array", "items": { "$ref": "#/$defs/artifact_ref" } },
        "video_scenes": { "type": "array", "items": { "$ref": "#/$defs/artifact_ref" } },
        "raw_scenes": { "type": "array", "items": { "$ref": "#/$defs/artifact_ref" } },
        "task_graph_logs": { "type": "array", "items": { "$ref": "#/$defs/artifact_ref" } }
      }
    },
    "memory_refs": {
      "type": "object",
      "required": ["task_graph_ids", "audio_memory_ids", "video_memory_ids", "sync_memory_ids"],
      "additionalProperties": false,
      "properties": {
        "task_graph_ids": { "type": "array", "items": { "type": "string" } },
        "audio_memory_ids": { "type": "array", "items": { "type": "string" } },
        "video_memory_ids": { "type": "array", "items": { "type": "string" } },
        "sync_memory_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "received",
        "parsing",
        "graphing",
        "branching",
        "processing_audio",
        "processing_video",
        "face_swapping",
        "syncing",
        "completed",
        "failed",
        "resumed"
      ]
    },
    "errors": {
      "type": "array",
      "items": { "$ref": "#/$defs/error" }
    },
    "audit": {
      "type": "object",
      "required": ["tool_calls", "node_history", "branch_history"],
      "additionalProperties": false,
      "properties": {
        "tool_calls": { "type": "array", "items": { "$ref": "#/$defs/tool_call" } },
        "node_history": { "type": "array", "items": { "type": "string" } },
        "branch_history": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "details": {}
      }
    },
    "tool_call": {
      "type": "object",
      "required": ["tool", "status", "timestamp"],
      "additionalProperties": false,
      "properties": {
        "tool": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["success", "failure"] },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "artifact_ref": {
      "type": "object",
      "required": ["artifact_id", "path", "type"],
      "additionalProperties": false,
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "scene_id": { "type": "string" },
        "duration_seconds": { "type": "number", "minimum": 0 },
        "frame_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}