{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-montage/phase1/character_db.schema.json",
  "title": "Character Database",
  "type": "object",
  "required": ["schema_version", "request_id", "characters"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/character"
      }
    }
  },
  "$defs": {
    "character": {
      "type": "object",
      "required": [
        "character_id",
        "name",
        "personality_traits",
        "appearance",
        "reference_style",
        "identity_consistency",
        "image_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "character_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "personality_traits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "appearance": {
          "type": "object",
          "required": ["age_range", "build", "hair", "face", "wardrobe"],
          "additionalProperties": false,
          "properties": {
            "age_range": { "type": "string", "minLength": 1 },
            "build": { "type": "string", "minLength": 1 },
            "hair": { "type": "string", "minLength": 1 },
            "face": { "type": "string", "minLength": 1 },
            "wardrobe": { "type": "string", "minLength": 1 }
          }
        },
        "reference_style": {
          "type": "string",
          "minLength": 1
        },
        "identity_consistency": {
          "type": "object",
          "required": ["embedding_key", "version"],
          "additionalProperties": false,
          "properties": {
            "embedding_key": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "continuity_score": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "image_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/image_ref"
          }
        }
      }
    },
    "image_ref": {
      "type": "object",
      "required": ["asset_id", "path", "prompt_hash"],
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "prompt_hash": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
