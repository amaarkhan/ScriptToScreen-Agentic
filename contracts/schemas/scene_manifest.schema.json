{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-montage/phase1/scene_manifest.schema.json",
  "title": "Scene Manifest",
  "type": "object",
  "required": ["schema_version", "request_id", "input_mode", "scenes"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "input_mode": {
      "type": "string",
      "enum": ["manual", "auto"]
    },
    "title": {
      "type": "string"
    },
    "logline": {
      "type": "string"
    },
    "theme": {
      "type": "string"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    }
  },
  "$defs": {
    "scene": {
      "type": "object",
      "required": [
        "scene_id",
        "order",
        "location",
        "time_of_day",
        "characters",
        "actions",
        "dialogue",
        "visual_cues"
      ],
      "additionalProperties": false,
      "properties": {
        "scene_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "time_of_day": {
          "type": "string",
          "minLength": 1
        },
        "characters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "dialogue": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/dialogue_line"
          }
        },
        "visual_cues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/visual_cue"
          }
        }
      }
    },
    "action": {
      "type": "object",
      "required": ["id", "description"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dialogue_line": {
      "type": "object",
      "required": ["speaker", "line", "visual_clue"],
      "additionalProperties": false,
      "properties": {
        "speaker": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "string",
          "minLength": 1
        },
        "visual_clue": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "visual_cue": {
      "type": "object",
      "required": ["id", "type", "description"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "type": {
          "type": "string",
          "enum": ["camera", "lighting", "mood", "blocking", "style"]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
